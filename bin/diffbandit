#!/bin/sh
# Open DiffBandit for the git repository in the current directory.
# Symlink this onto PATH as `diffbandit`, and as `git-diffbandit` to get
# `git diffbandit`.

usage() {
  cat <<'EOF'
usage: diffbandit [--cached] [--no-untracked] [<rev> [<rev>] | <a>..<b> | <a>...<b>] [--] [<path>...]
       diffbandit show <rev> [--] [<path>...]
       diffbandit compare [--direct | --unpushed] [<base> [<target>]] [--] [<path>...]
       diffbandit log [--all] [-n <count>] [<rev>] [--] [<path>...]
       diffbandit stash [<n>] [--] [<path>...]

  (no revision)   working tree changes, with the commit panel
  --cached        staged changes
  <rev>           working tree compared with <rev>
  <a> <b>, <a>..<b>
                  read-only review of <a> against <b>
  <a>...<b>       read-only review of <b> against its merge base with <a>
  show <rev>      read-only review of a single commit
  compare [<base>]
                  everything the branch changes, committed or not: the
                  working tree against its merge base with <base> (default:
                  origin/HEAD, else main or master), with the commit panel
    --direct      compare with <base> itself, not the merge base
    --unpushed    compare with the branch's upstream (what is not pushed)
  compare <base> <target>
                  read-only review, the same as <base>...<target>
  log             commit log browser; Enter reviews a commit
                  (latest 1000 commits unless -n is given)
  stash [<n>]     read-only review of stash@{<n>} (default 0)

A subcommand wins over a branch or path with the same name; write
`diffbandit -- log` to mean the path.

External tool mode (jj merge-tools, git mergetool/difftool):
  diffbandit merge <base> <left> <right> <output> [--path P]
                  three-way merge; exits non-zero unless resolved with :w
  diffbandit edit <left> <right>
                  diff editor: edit the right folder/file (jj split, squash -i)
  diffbandit diff <left> <right>
                  read-only folder or file diff

Environment:
  DIFFBANDIT_NVIM          nvim executable (default: nvim)
  DIFFBANDIT_NVIM_APPNAME  NVIM_APPNAME for a dedicated nvim config
EOF
}

case "$1" in
  -h|--help|help) usage; exit 0 ;;
esac

if [ -n "$DIFFBANDIT_NVIM_APPNAME" ]; then
  NVIM_APPNAME=$DIFFBANDIT_NVIM_APPNAME
  export NVIM_APPNAME
fi

# Arguments travel through the environment (unit-separator joined) so nvim
# never opens them as files.
DIFFBANDIT_ARGV=
if [ $# -gt 0 ]; then
  DIFFBANDIT_ARGV=$(printf '%s\037' "$@")
fi
DIFFBANDIT_ERRFILE=$(mktemp "${TMPDIR:-/tmp}/diffbandit.XXXXXX") || exit 1
# The merge subcommand records "resolved" here; quitting without resolving
# must fail so jj/git keep the conflict.
DIFFBANDIT_STATUSFILE=$(mktemp "${TMPDIR:-/tmp}/diffbandit-status.XXXXXX") || exit 1
export DIFFBANDIT_ARGV DIFFBANDIT_ERRFILE DIFFBANDIT_STATUSFILE
trap 'rm -f "$DIFFBANDIT_ERRFILE" "$DIFFBANDIT_STATUSFILE"' EXIT

# Prefer the command: lazy plugin managers load the plugin on its commands,
# not on require().
"${DIFFBANDIT_NVIM:-nvim}" -c 'lua
  local ok, launcher
  if vim.fn.exists(":DiffBanditLaunch") == 2 then
    vim.cmd("DiffBanditLaunch")
    return
  end
  ok, launcher = pcall(require, "diffbandit.launcher")
  if ok then
    launcher.main()
  else
    vim.fn.writefile({ "diffbandit: diffbandit.nvim is not installed in this nvim config" }, vim.env.DIFFBANDIT_ERRFILE)
    vim.cmd("cquit 1")
  end'
status=$?
if [ -s "$DIFFBANDIT_ERRFILE" ]; then
  cat "$DIFFBANDIT_ERRFILE" >&2
fi
if [ "$1" = merge ] && [ "$status" -eq 0 ] && ! grep -q resolved "$DIFFBANDIT_STATUSFILE"; then
  echo "diffbandit: merge not resolved (save the result with :w)" >&2
  status=1
fi
exit $status
